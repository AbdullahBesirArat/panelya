NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://panelya_user:change_me@localhost:5432/panelya
# Runtime is a non-owner/non-superuser role. Migrations and explicit cross-tenant
# workers use separate credentials; all three roles must be distinct in production.
RUNTIME_DATABASE_URL=postgresql://panelya_runtime:change_me@localhost:5432/panelya
MIGRATION_DATABASE_URL=postgresql://panelya_migrator:change_me@localhost:5432/panelya
SYSTEM_DATABASE_URL=postgresql://panelya_system_runtime:change_me@localhost:5432/panelya
DATABASE_ADMIN_URL=
RUNTIME_DATABASE_PASSWORD=
MIGRATION_DATABASE_PASSWORD=
SYSTEM_DATABASE_PASSWORD=
JWT_SECRET_APP=generate_64_plus_chars_with_openssl_rand_base64_64
JWT_SECRET_ADMIN=generate_another_64_plus_chars_with_openssl_rand_base64_64
JWT_EXPIRES_IN=2h
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
ADMIN_USERNAME=admin
ADMIN_ROLE=super_admin
# Only for local bootstrap, never enable in production.
ALLOW_ENV_ADMIN_LOGIN=false
ADMIN_PASSWORD_HASH=
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://localhost:4173,http://127.0.0.1:4173
DEFAULT_ORGANIZATION_PLAN=growth
API_RATE_LIMIT=1200
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=6
ORDER_CREATE_RATE_LIMIT=60
PAYMENT_INIT_RATE_LIMIT=40
UPLOAD_RATE_LIMIT=40
# Legacy upload delivery/backfill only; new uploads use the object adapter below.
UPLOAD_DIR=../uploads
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_LOCAL_DIR=.data/object-storage
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
INVOICE_IDENTITY_ENCRYPTION_KEY=generate_a_base64_encoded_32_byte_key

# A29: webhook signing secrets are ENCRYPTED (not hashed) because the sender must
# reproduce them to compute an HMAC. Its own key, never the invoice one: sharing would mean
# one compromise exposes both and neither could be rotated independently.
WEBHOOK_SECRET_ENCRYPTION_KEY=generate_a_base64_encoded_32_byte_key
SHIPPING_WEBHOOK_SECRET=generate_32_plus_chars_for_signed_shipping_callbacks
MEDIA_ORPHAN_GRACE_DAYS=7
PAYMENT_PROVIDER=mock
PAYMENT_CALLBACK_SECRET=generate_32_plus_chars_for_signed_callbacks
EMAIL_PROVIDER=brevo
EMAIL_FROM=notifications@example.com
RESEND_API_KEY=
BREVO_API_KEY_SUVERA=
BREVO_API_KEY_PANELYA=
BREVO_SENDER_SUVERA=noreply@suvera.com.tr
BREVO_SENDER_SUVERA_NAME=Suvera
BREVO_SENDER_PANELYA=noreply@panelya.com.tr
BREVO_SENDER_PANELYA_NAME=Panelya
BREVO_LIST_ID_CUSTOMERS=
BREVO_LIST_ID_NEWSLETTER=
EMAIL_VERIFICATION_TTL_HOURS=24
PUBLIC_SITE_URL=http://localhost:3001
PUBLIC_APP_URL=https://app.panelya.com.tr
PUBLIC_API_URL=http://localhost:3000
PAYMENT_CALLBACK_URL=http://localhost:3000/api/payment/callback
PAYMENT_SUCCESS_URL=http://localhost:3001/tesekkur.html
PAYMENT_FAILURE_URL=http://localhost:3001/tesekkur.html?payment=failed
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_DEFAULT_IDENTITY_NUMBER=11111111110
PAYMENT_PENDING_TIMEOUT_MINUTES=30
PAYMENT_PENDING_EXPIRE_LIMIT=100
INVENTORY_RESERVATION_TTL_MINUTES=15
INVENTORY_RESERVATION_EXPIRE_LIMIT=100
INVENTORY_RESERVATION_WORKER_STALE_MINUTES=10
MANUAL_PAYMENT_INVENTORY_MODE=reserve
MANUAL_RESERVATION_TTL_MINUTES=120
PAYMENT_MOCK_AUTO_PAY=false
COUPON_EVALUATE_RATE_LIMIT=30
PAYMENT_CALLBACK_SECRET_REQUIRED=false
ORDER_NOTIFICATION_OUTBOX_WORKER_ENABLED=true
ORDER_NOTIFICATION_OUTBOX_INTERVAL_MS=15000
ORDER_NOTIFICATION_OUTBOX_BATCH_SIZE=25
ORDER_NOTIFICATION_OUTBOX_STALE_MINUTES=10
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000
SLOW_QUERY_THRESHOLD_MS=250
API_REQUEST_TIMEOUT_MS=30000
DB_SYSTEM_POOL_MAX=4
DB_MIGRATION_POOL_MAX=2
