NODE_ENV=production
DATABASE_URL=postgresql://panelya_runtime:CHANGE_STRONG_RUNTIME_PASSWORD@localhost:5432/panelya
RUNTIME_DATABASE_URL=postgresql://panelya_runtime:CHANGE_STRONG_RUNTIME_PASSWORD@localhost:5432/panelya
MIGRATION_DATABASE_URL=postgresql://panelya_migrator:CHANGE_STRONG_MIGRATOR_PASSWORD@localhost:5432/panelya
SYSTEM_DATABASE_URL=postgresql://panelya_system_runtime:CHANGE_STRONG_SYSTEM_PASSWORD@localhost:5432/panelya
# Provisioning-only values; do not keep DATABASE_ADMIN_URL in the runtime service.
DATABASE_ADMIN_URL=
RUNTIME_DATABASE_PASSWORD=
MIGRATION_DATABASE_PASSWORD=
SYSTEM_DATABASE_PASSWORD=
JWT_SECRET_APP=CHANGE_TO_A_CRYPTO_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_SECRET_ADMIN=CHANGE_TO_A_DIFFERENT_CRYPTO_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=2h
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
ADMIN_USERNAME=admin
ADMIN_ROLE=super_admin
ALLOW_ENV_ADMIN_LOGIN=false
ADMIN_PASSWORD_HASH=
CORS_ORIGIN=https://panelya.com.tr,https://www.panelya.com.tr,https://panelya-web.vercel.app,https://suvera.com.tr,https://www.suvera.com.tr
DEFAULT_ORGANIZATION_PLAN=growth
API_RATE_LIMIT=1200
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=6
ORDER_CREATE_RATE_LIMIT=60
PAYMENT_INIT_RATE_LIMIT=40
UPLOAD_RATE_LIMIT=40
# Legacy-only read/backfill path. New uploads never persist here.
UPLOAD_DIR=/var/www/panelya/uploads
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=CHANGE_TO_MEDIA_BUCKET
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=https://CHANGE_TO_S3_COMPATIBLE_ENDPOINT
OBJECT_STORAGE_ACCESS_KEY_ID=CHANGE_TO_STORAGE_ACCESS_KEY
OBJECT_STORAGE_SECRET_ACCESS_KEY=CHANGE_TO_STORAGE_SECRET_KEY
OBJECT_STORAGE_PUBLIC_BASE_URL=https://CHANGE_TO_MEDIA_CDN_HOST
OBJECT_STORAGE_FORCE_PATH_STYLE=false
INVOICE_IDENTITY_ENCRYPTION_KEY=CHANGE_TO_BASE64_ENCODED_32_BYTE_KEY

# A34: keep every secret in the deployment secret store; never commit values here.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=https://panelya-web.vercel.app/api/bff/instagram-imports/oauth/callback
INSTAGRAM_GRAPH_API_VERSION=v26.0
INSTAGRAM_PROVIDER_TIMEOUT_MS=10000
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_WORKER_ENABLED=true
INSTAGRAM_WORKER_INTERVAL_MS=10000
CATALOG_AI_PROVIDER=openai
CATALOG_AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
CATALOG_AI_TIMEOUT_MS=60000

# A29 webhook signing-secret encryption (32 bytes, base64 or hex). Distinct from the
# invoice identity key by design.
WEBHOOK_SECRET_ENCRYPTION_KEY=CHANGE_TO_BASE64_ENCODED_32_BYTE_KEY
SHIPPING_WEBHOOK_SECRET=CHANGE_TO_A_CRYPTO_RANDOM_SECRET_AT_LEAST_32_CHARS
MEDIA_ORPHAN_GRACE_DAYS=7
PAYMENT_PROVIDER=iyzico
PAYMENT_CALLBACK_SECRET=CHANGE_TO_A_CRYPTO_RANDOM_SECRET_AT_LEAST_32_CHARS
EMAIL_PROVIDER=brevo
EMAIL_FROM=notifications@example.com
RESEND_API_KEY=
BREVO_API_KEY_SUVERA=CHANGE_TO_SUVERA_BREVO_API_KEY
BREVO_API_KEY_PANELYA=CHANGE_TO_PANELYA_BREVO_API_KEY
BREVO_SENDER_SUVERA=verified-sender@suvera-account.com
BREVO_SENDER_SUVERA_NAME=Suvera
BREVO_SENDER_PANELYA=verified-sender@panelya-account.com
BREVO_SENDER_PANELYA_NAME=Panelya
BREVO_LIST_ID_CUSTOMERS=
BREVO_LIST_ID_NEWSLETTER=
EMAIL_VERIFICATION_TTL_HOURS=24
PUBLIC_SITE_URL=https://suvera-web.vercel.app
PUBLIC_APP_URL=https://panelya-web.vercel.app
PUBLIC_API_URL=https://api.panelya.com.tr
PAYMENT_CALLBACK_URL=https://api.panelya.com.tr/api/payment/callback
PAYMENT_SUCCESS_URL=https://suvera.com.tr/tesekkur.html
PAYMENT_FAILURE_URL=https://suvera.com.tr/tesekkur.html?payment=failed
IYZICO_API_KEY=CHANGE_IYZICO_API_KEY
IYZICO_SECRET_KEY=CHANGE_IYZICO_SECRET_KEY
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_DEFAULT_IDENTITY_NUMBER=CHANGE_OR_COLLECT_FROM_CUSTOMER
PAYMENT_PENDING_TIMEOUT_MINUTES=30
PAYMENT_PENDING_EXPIRE_LIMIT=100
INVENTORY_RESERVATION_TTL_MINUTES=15
INVENTORY_RESERVATION_EXPIRE_LIMIT=100
INVENTORY_RESERVATION_WORKER_STALE_MINUTES=10
MANUAL_PAYMENT_INVENTORY_MODE=reserve
MANUAL_RESERVATION_TTL_MINUTES=120
PAYMENT_MOCK_AUTO_PAY=false
COUPON_EVALUATE_RATE_LIMIT=30
PAYMENT_CALLBACK_SECRET_REQUIRED=true
ORDER_NOTIFICATION_OUTBOX_WORKER_ENABLED=true
ORDER_NOTIFICATION_OUTBOX_INTERVAL_MS=15000
ORDER_NOTIFICATION_OUTBOX_BATCH_SIZE=25
ORDER_NOTIFICATION_OUTBOX_STALE_MINUTES=10
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000
SLOW_QUERY_THRESHOLD_MS=250
API_REQUEST_TIMEOUT_MS=30000
DB_SYSTEM_POOL_MAX=4
DB_MIGRATION_POOL_MAX=2
